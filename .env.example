# ─── Trippy environment variables ───────────────────────────────────────────
# Copy this file to `.env` for local development:   cp .env.example .env
# In production these are set in Vercel → Project → Settings → Environment Variables.
# `.env` is git-committed NEVER (see .gitignore); this template is safe to commit.

# ── Required for AI features ────────────────────────────────────────────────
# Google Gemini API key — powers itinerary generation, the concierge chat,
# destination discovery and recommendations.
# Get one at https://aistudio.google.com/apikey
# Without it the app still runs, but AI endpoints return simulated fallback data.
GEMINI_API_KEY=your_gemini_api_key

# ── Required for Google Sign-In ─────────────────────────────────────────────
# Firebase web API key (Firebase Console → Project settings → General → Your apps).
# Served to the browser via GET /api/firebase-config; without it the Firebase
# client cannot initialize and Google popup login will fail.
# Email/password login works without this key.
FIREBASE_API_KEY=your_firebase_web_api_key

# ── Optional: cloud persistence ─────────────────────────────────────────────
# Firebase service account JSON as a SINGLE LINE string (Firebase Console →
# Project settings → Service accounts → Generate new private key, then flatten
# the JSON: {"type":"service_account","key_id":"...",...}).
# Powers the Admin SDK's Firestore mirror (server/firebase-admin.ts).
# Without it the server runs in local-only mode: data persists in server/db.json
# on the deploy machine's filesystem — fine for demos, not for production.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Optional: richer weather data ───────────────────────────────────────────
# OpenWeatherMap API key (https://openweathermap.org/api).
# Without it weather gracefully falls back to the keyless Open-Meteo API.
OPENWEATHER_API_KEY=

# ── Runtime (usually injected by the host, rarely set manually) ─────────────
# HTTP port. Defaults to 3000 locally; Vercel/hosts inject their own.
# PORT=3000
# Set automatically by Vercel during `npm run build` — do not set manually.
# NODE_ENV=production
# AI Studio development helper: set to "true" to disable Vite HMR/file watching.
# DISABLE_HMR=true
